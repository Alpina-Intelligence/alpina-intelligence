# Pin gh to the personal account for everything under this repo (AGENTS.md
# "GitHub account"). GH_TOKEN outranks gh's globally-active account, so work-vs-
# personal switching elsewhere can't leak into API calls made from here.
# The token comes from the keyring at directory entry — nothing stored in-repo.
export GH_TOKEN="$(gh auth token --user eric-austin 2>/dev/null)"

# Local Hyperdrive override (ADR-0005 §7). App code reads
# env.HYPERDRIVE.connectionString in BOTH tiers, so `bun run dev` — whose SSR
# environment runs under workerd — needs the local stack's URL under Wrangler's
# local-override name. Sourced from infra/local/.env.local (gitignored, fake
# creds) so there is no second copy of the password and nothing lands in the
# committed wrangler.jsonc. Inert until the binding is declared.
#
# Keyed by BINDING name, not app: a second DB-backed app whose binding is also
# called HYPERDRIVE would collide in this one shell. Give it a distinct binding
# name when that happens.
if [ -f infra/local/.env.local ]; then
  # Percent-encode the password: .env.local.example suggests `openssl rand
  # -base64 24`, which yields '/' in ~40% of draws, and a raw '/' breaks both
  # URL parsing and postgres-js. jq -Rr @uri is RFC 3986-safe (raw per-line,
  # no slurp — -s would encode sed's trailing newline into the password).
  export CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE="postgres://www_svc:$(sed -n 's/^PGPASSWORD=//p' infra/local/.env.local | jq -Rr @uri)@127.0.0.1:5434/www"
fi
