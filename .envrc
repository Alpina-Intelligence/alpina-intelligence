# Pin gh to the personal account for everything under this repo (AGENTS.md
# "GitHub account"). GH_TOKEN outranks gh's globally-active account, so work-vs-
# personal switching elsewhere can't leak into API calls made from here.
# The token comes from the keyring at directory entry — nothing stored in-repo.
export GH_TOKEN="$(gh auth token --user eric-austin 2>/dev/null)"
