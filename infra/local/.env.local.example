# Copy to .env.local (gitignored) and replace the values. These are LOCAL-ONLY fake
# credentials for a container on loopback — never reuse them anywhere real.
#
#   cd infra/local && cp .env.local.example .env.local
#   docker compose --env-file .env.local up -d
#
#   Generate values with:  openssl rand -hex 32
#
# This file is the SINGLE SOURCE for the app database password. App .env files do
# NOT repeat it — read PGPASSWORD from here so a rotation can't leave two halves
# disagreeing.

# Superuser, used only by the container entrypoint and the initdb script.
POSTGRES_PASSWORD=replace-me-superuser

# The <app>_svc roles' password — what apps actually connect with. libpq's own
# variable name, so `psql` on the host picks it up too. (One password shared by
# all local app roles: these are fake loopback creds, not an isolation boundary.)
PGPASSWORD=replace-me-app-role
