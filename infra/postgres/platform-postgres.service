# systemd unit that makes the shared Postgres container a first-class host service.
# Install on the VPS:
#   cp platform-postgres.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now platform-postgres
#
# `restart: unless-stopped` in compose already brings the container back after a
# reboot; this unit adds explicit lifecycle (`systemctl status/stop/start`) and ties
# ordering to docker.service so it never races the daemon on boot.
[Unit]
Description=Shared platform Postgres (host container, outside k3s)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/platform/postgres
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
