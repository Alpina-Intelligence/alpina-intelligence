# Shape of the real `.env`, which lives ONLY on the VPS at
# /opt/platform/postgres/.env (root-owned, chmod 600, NEVER committed).
#
# Generate on the box:
#   umask 077
#   printf 'POSTGRES_PASSWORD=%s\n' "$(openssl rand -hex 24)" > .env
#
# This is the ONLY secret in this file. Per-project role passwords are generated by
# provision-db.sh into ./secrets/<project>.env — they are per-project secrets and do
# not belong to the platform tier.
#
# Back this up in Bitwarden as `platform/postgres-superuser`.
POSTGRES_PASSWORD=changeme
