# Shape only. The real file lives at /etc/cloudflared/cloudflared.env on the VPS,
# root-owned 0600, and is never committed.
#
# This is the tunnel connector token: it authorizes "I am the connector for tunnel
# <id>". It is a RUNTIME credential — cloudflared needs it on every start, so it
# cannot live in CI. Distinct from CLOUDFLARE_API_TOKEN, the management credential
# Terraform uses, which lives in CI and never touches the box.
#
# Read the current value with:
#   cloudflared tunnel token <tunnel-name>      (or the /cfd_tunnel/<id>/token API)

TUNNEL_TOKEN=
