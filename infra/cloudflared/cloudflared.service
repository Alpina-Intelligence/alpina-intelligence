# The tunnel connector. Outbound-only: this is the ONLY way traffic reaches the box,
# and the reason no inbound port but :22 is open.
#
# The tunnel is REMOTELY managed (config_src=cloudflare) — ingress rules live in the
# Cloudflare API and are owned by Terraform, NOT by a config.yml here. Adding a route
# is a Terraform change; this unit never changes for it.
#
# TUNNEL_TOKEN comes from the EnvironmentFile, never from the command line: anything in
# ExecStart is world-readable via `ps -eo args`, /proc/*/cmdline and `systemctl cat`.

[Unit]
Description=cloudflared
After=network-online.target
Wants=network-online.target

[Service]
# Type=notify means readiness is only signalled once a connection REGISTERS, and
# cloudflared's own retry backs off 2→4→8→16→32s. A short start timeout therefore kills it
# mid-backoff on any failure lasting longer, and it restarts into the same trap forever
# (seen 2026-08-01: a stale token after rotation produced an endless restart loop instead
# of a process retrying until the token was fixed). Let the internal retry do its job.
TimeoutStartSec=120
Type=notify
EnvironmentFile=/etc/cloudflared/cloudflared.env
ExecStart=/usr/bin/cloudflared --no-autoupdate tunnel run
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
